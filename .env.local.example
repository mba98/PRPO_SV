# =============================================================================
# Procurement Portal — Environment Variables (example)
# =============================================================================
# Copy this file to `.env.local` and fill in values for local development:
#   cp .env.local.example .env.local
#
# Safe to commit: use placeholders only. Never commit real secrets or `.env.local`.
# =============================================================================

# -----------------------------------------------------------------------------
# App / Runtime
# -----------------------------------------------------------------------------
# NODE_ENV is set automatically by Next.js (development | production | test).
# NODE_ENV=development

# Optional: port for `next start` on self-hosted Node (default 3000).
# PORT=3000

# Optional: public app URL for absolute links in emails (future phases).
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# MongoDB
# -----------------------------------------------------------------------------
# Local development (no TLS):
# MONGODB_URI=mongodb://127.0.0.1:27017/procurement_portal
#
# --- MongoDB Atlas (choose ONE format) ---
#
# Option A — SRV (preferred when Node DNS resolves SRV records):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/procurement_portal?retryWrites=true&w=majority&appName=ProcurementPortal
#
# Option B — Non-SRV fallback (use if querySrv ECONNREFUSED or Server selection timed out):
# Copy host list from Atlas → Connect → Drivers → "Standard connection string"
# MONGODB_URI=mongodb://<username>:<password>@ac-xxxx-shard-00-00.xxxxx.mongodb.net:27017,ac-xxxx-shard-00-01.xxxxx.mongodb.net:27017,ac-xxxx-shard-00-02.xxxxx.mongodb.net:27017/procurement_portal?tls=true&replicaSet=atlas-xxxxx-shard-0&authSource=admin&retryWrites=true&w=majority
#
# Atlas checklist (server):
#   1. Network Access → IP Access List → add this server's PUBLIC outbound IP
#   2. Database Access → user with readWrite on procurement_portal (or your DB name)
#   3. URL-encode special characters in password (@ : / ? # etc.)
#   4. Run: npm run db:check   then: npm run seed  (fresh DB only)
#   5. Node.js 20 LTS recommended on Windows Server (see .nvmrc); Node 24 may fail SRV DNS
#
# Common typo: mmongodb+srv → must be mongodb+srv (single "m")
MONGODB_URI=mongodb://127.0.0.1:27017/procurement_portal

# -----------------------------------------------------------------------------
# Auth / JWT
# -----------------------------------------------------------------------------
# Secret for signing portal_session JWT cookies (use a long random string in prod).
JWT_SECRET=your-jwt-secret-min-32-characters-change-me

# Token lifetime: suffix h (hours), m (minutes), or s (seconds). Default in code: 8h.
JWT_EXPIRES_IN=8h

# -----------------------------------------------------------------------------
# First-run Admin Seed (`npm run seed` — fresh database only)
# -----------------------------------------------------------------------------
# Credentials for the initial Admin user created by the seed script.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=your-secure-seed-password

# -----------------------------------------------------------------------------
# SAP Business One Service Layer (REST — document creation & lookups)
# -----------------------------------------------------------------------------
# Base URL including /b1s/v1 path. Self-hosted Node required (not Edge/Vercel).
SAP_SL_BASE_URL=https://your-sap-host:50000/b1s/v1
SAP_SL_USERNAME=your-sap-sl-username
SAP_SL_PASSWORD=your-sap-sl-password
SAP_SL_COMPANY_DB=your-company-database-name

# -----------------------------------------------------------------------------
# SAP HANA ODBC (item search & reporting)
# -----------------------------------------------------------------------------
# Full ODBC connection string used by lib/sapHana.js (odbc npm package).
# Example (adjust driver/host/credentials): Driver={HDBODBC};ServerNode=host:30015;UID=user;PWD=password;
HANA_CONNECTION_STRING=

# Spec alternative (not wired in code yet): system DSN name instead of connection string.
# HANA_DSN=YourHanaSystemDSN

# -----------------------------------------------------------------------------
# AWS S3 (attachments — pre-signed upload/download)
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=your-portal-attachments-bucket

# -----------------------------------------------------------------------------
# SMTP / Email (Nodemailer — notifications & health probe)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@example.com
