# Copy to .env.local and fill in values.

MONGODB_URI=mongodb://localhost:27017/prpo_sv

# Required in production (>= 32 chars). App refuses to start without it when NODE_ENV=production.
JWT_SECRET=your-jwt-secret-min-32-characters-change-me
JWT_EXPIRES_IN=8h

# Session cookie Secure flag. Required false for HTTP deployments (internal IP/host without TLS).
# COOKIE_SECURE=false

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me

# SAP Business One Service Layer
SAP_SL_BASE_URL=https://your-sap-host:50000/b1s/v1
SAP_SL_USERNAME=manager
SAP_SL_PASSWORD=change-me
SAP_SL_COMPANY_DB=YOUR_COMPANY_DB
# Self-signed cert on internal host:
SAP_SL_INSECURE_TLS=true

# SAP Purchase Request defaults (confirmed Postman payload)
DEFAULT_SAP_REQUESTER_CODE=manager
SAP_REQUESTER_CODE_REQUESTER=manager
DEFAULT_SAP_WAREHOUSE_CODE=RAN004
SAP_PR_REQ_TYPE=12

SAP_PR_BASE_TYPE=1470000113

# Standalone SAP PO (no PR base document)
DEFAULT_PO_DOC_CURRENCY=USD
DEFAULT_PO_DOC_RATE=1350
# SAP_PO_SEND_PR_UDF_FIELDS=true

# HANA item search (optional)
# HANA_CONNECTION_STRING=
# HANA_SCHEMA=YOUR_COMPANY_DB
# Auto-generated SAP item codes (prefix + numeric suffix, e.g. 1250000133)
# SAP_ITEM_CODE_PREFIX=125
# SAP_ITEM_CODE_START=1250000001

# ----------------------------------------------------------------------------
# AWS S3 (attachments — presigned browser PUT/GET)
# Bucket CORS must allow each browser origin (see docs/S3_ATTACHMENT_CORS.md).
# Example internal HTTP origin: http://172.30.30.96:5420
# ----------------------------------------------------------------------------
# AWS_REGION=eu-north-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=your-bucket-name

# ----------------------------------------------------------------------------
# SMTP / Email
# Two naming styles are supported. SMTP_* is the preferred style for this
# project; EMAIL_SERVER_* is accepted as a backward-compatible fallback so
# shared infrastructure configs from other projects continue to work.
# SMTP_* takes precedence over EMAIL_SERVER_* when both are set.
# Never commit real credentials. Gmail values shown only as an example.
# ----------------------------------------------------------------------------

# Preferred (SMTP_*)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=your-account@gmail.com

# Backward-compatible fallback (EMAIL_SERVER_*)
# EMAIL_SERVER_HOST=smtp.gmail.com
# EMAIL_SERVER_PORT=587
# EMAIL_SERVER_USER=your-account@gmail.com
# EMAIL_SERVER_PASSWORD=your-app-password

# Portal base URL for email CTA links (preferred APP_BASE_URL, or NEXT_PUBLIC_APP_URL)
# APP_BASE_URL=https://your-portal-host.example.com
